DATABASE_URL=postgresql://echolearn:echolearn@localhost:5432/echolearn
JWT_SECRET=change_this_to_a_long_random_string
GROQ_API_KEY=
GEMINI_API_KEY=
RESEND_API_KEY=
FRONTEND_URL=http://localhost:3000

# Real email delivery (optional): SMTP2GO's free tier (smtp2go.com, 1000 emails/month,
# no card) lets you verify a single sender EMAIL you already own instead of a whole
# domain — then it delivers to any real recipient, unlike Resend's sandbox restriction.
# Any standard SMTP provider works here. Takes priority over RESEND_API_KEY when set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
STORAGE_PATH=./storage
CHROMA_PATH=./chroma_data
HF_HOME=

# Production vector store (optional): set both to use Qdrant Cloud instead of local
# Chroma — needed if the backend's filesystem is ephemeral (e.g. Render's free tier),
# since a local Chroma index would be wiped on every restart/redeploy. Leave blank for
# local dev; app/rag/vectorstore.py picks Chroma automatically when these are empty.
QDRANT_URL=
QDRANT_API_KEY=

# Object storage (optional): backs up each document's original file + parsed text to an
# S3-compatible bucket (Cloudflare R2's free 10GB tier is the intended target), so they
# survive a restart on a host with an ephemeral filesystem. Leave all four blank for
# local dev / local disk only. See app/documents/object_storage.py.
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
VOICE_BACKEND=local
VOICE_MODEL_PATH=./voices/en_US-lessac-high.onnx
VOICE_HF_SPACE_URL=
VOICE_AUDIO_CACHE_PATH=./storage/audio

# Voice cloning (optional): Fish Audio API (fish.audio) — no local model, works on any
# host. Free tier (s2.1-pro-free) has no hard usage cap under fair use, no card needed.
FISH_AUDIO_API_KEY=
