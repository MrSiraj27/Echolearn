DATABASE_URL=postgresql://echolearn:echolearn@localhost:5432/echolearn
JWT_SECRET=change_this_to_a_long_random_string
GROQ_API_KEY=
GEMINI_API_KEY=
RESEND_API_KEY=
FRONTEND_URL=http://localhost:3000
STORAGE_PATH=./storage
CHROMA_PATH=./chroma_data
TESSERACT_CMD=
HF_HOME=

# Production vector store (optional): set both to use Qdrant Cloud instead of local
# Chroma — needed if the backend's filesystem is ephemeral (e.g. Render's free tier),
# since a local Chroma index would be wiped on every restart/redeploy. Leave blank for
# local dev; app/rag/vectorstore.py picks Chroma automatically when these are empty.
QDRANT_URL=
QDRANT_API_KEY=
VOICE_BACKEND=local
VOICE_MODEL_PATH=./voices/en_US-lessac-high.onnx
VOICE_HF_SPACE_URL=
VOICE_AUDIO_CACHE_PATH=./storage/audio

# Voice cloning (optional): isolated MOSS-TTS-Nano worker. Leave blank to use the defaults.
VOICE_CLONE_WORKER_PYTHON=
VOICE_CLONE_WORKER_SCRIPT=./voice_worker/worker.py
VOICE_CLONE_WORKER_PORT=8765
VOICE_CLONE_WORKER_AUTOSTART=true
VOICE_CLONE_WORKER_THREADS=0
